# ─── CloudERP Backend – Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit the actual .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from: Atlas → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clouderp?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# IMPORTANT: Use minimum 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_min_32_char_random_string
JWT_REFRESH_SECRET=replace_with_different_min_32_char_random_string

# ── CORS & Frontend ───────────────────────────────────────────────────────────
# Set to your deployed Vercel/Netlify URL (no trailing slash)
FRONTEND_URL=https://cloud-erp-delta.vercel.app
CORS_ORIGINS=https://cloud-erp-delta.vercel.app
SOCKET_CORS_ORIGINS=https://cloud-erp-delta.vercel.app

# ── FastAPI ML Service ────────────────────────────────────────────────────────
# Set to your deployed Render ML service URL
ML_SERVICE_URL=https://clouderp-ml-service.onrender.com

# ── SMTP Email (Nodemailer) ───────────────────────────────────────────────────
# For Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="CloudERP Systems" <noreply@clouderp.com>
