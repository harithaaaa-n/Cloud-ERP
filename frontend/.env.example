# ─── CloudERP Frontend – Environment Variables ────────────────────────────────
# Copy to .env.local for dev, .env.production for production builds.
# All VITE_ prefixed variables are embedded at build time — do NOT put secrets here.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Development: leave empty — Vite proxy handles /api → http://localhost:5000
# Production : set to your deployed backend URL (no trailing slash)
VITE_API_URL=https://clouderp-backend.onrender.com

# ── App Config ────────────────────────────────────────────────────────────────
VITE_APP_NAME=CloudERP
VITE_APP_VERSION=1.0.0
